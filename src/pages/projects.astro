---
import BasicLayout from "../layouts/BasicLayout.astro";
import { PROJECTS } from "../lib/projects";
import { PROFILE, LINKS } from "../lib/constants";
import { Icon } from "astro-icon/components";
---

<BasicLayout
  title={`${PROFILE.name} - Projects & Technical Work`}
  description="Selected frontend engineering and cybersecurity projects by Yefa."
  page="projects"
>
  <div class="w-full max-w-6xl mx-auto px-4 py-8 md:py-12 text-white">
    <!-- Top Navigation Header -->
    <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
      <div class="flex items-center gap-4">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-xs font-semibold text-slate-100 bg-darkslate-400 hover:bg-darkslate-300 px-3.5 py-2 border border-slate-700 hover:border-primary-400 rounded-lg transition-all"
        >
          <Icon name="ri:arrow-left-line" class="h-4 w-4" />
          <span>Back to Bento</span>
        </a>
        <div class="h-4 w-[1px] bg-slate-700"></div>
        <span class="text-xs text-primary-300 font-mono font-bold">portfolio / projects</span>
      </div>

      <div class="flex items-center gap-3">
        <a
          href={LINKS.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs text-slate-100 font-semibold hover:text-white px-3 py-1.5 rounded-md bg-darkslate-400 border border-slate-700 hover:border-primary-400 transition-colors"
        >
          <Icon name="ri:github-fill" class="h-4 w-4" />
          <span>GitHub</span>
        </a>
        <a
          href={`mailto:${LINKS.email}`}
          class="inline-flex items-center gap-1.5 text-xs text-primary-200 font-bold hover:text-white px-3 py-1.5 rounded-md bg-primary-600/30 border border-primary-400/50 hover:bg-primary-500/40 transition-colors"
        >
          <Icon name="ri:mail-send-line" class="h-4 w-4" />
          <span>Contact</span>
        </a>
      </div>
    </header>

    <!-- Page Title & Overview -->
    <section class="mb-10">
      <div class="flex items-center gap-2 mb-2">
        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-primary-500/25 text-primary-200 border border-primary-400/50">
          Engineering & Defense
        </span>
        <span class="text-xs text-slate-200 font-semibold">10+ Years Building Scalable Systems</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-white mb-3">
        Selected Projects & Systems
      </h1>
      <p class="text-slate-100 text-base sm:text-lg max-w-3xl leading-relaxed font-normal">
        A showcase of enterprise frontend architectures, secure dashboards, and cybersecurity defense tooling that combine intuitive user experiences with battle-tested security postures.
      </p>
    </section>

    <!-- Featured Flagship Project (Viuumi) -->
    {PROJECTS.filter(p => p.featured && p.id === "viuumi-admin").map((project) => (
      <article class="mb-8 rounded-xl bg-darkslate-500/90 border border-primary-500/50 p-6 md:p-8 shadow-xl relative overflow-hidden group hover:border-primary-400 transition-all">
        <div class="absolute -right-16 -top-16 w-64 h-64 bg-primary-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
          <div class="flex items-center gap-2.5">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="text-xs font-bold uppercase tracking-wider text-emerald-300">
              {project.badge}
            </span>
            <span class="text-xs text-slate-200 font-semibold">• {project.category}</span>
          </div>
          <span class="text-xs font-mono text-slate-100 font-semibold px-2.5 py-1 rounded bg-darkslate-400 border border-slate-700">
            Role: {project.role}
          </span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
          <div class="lg:col-span-7 flex flex-col justify-between">
            <div>
              <h2 class="text-2xl md:text-3xl font-bold text-white mb-3">
                {project.title}
              </h2>
              <p class="text-slate-100 text-sm sm:text-base leading-relaxed mb-6 font-normal">
                {project.description}
              </p>

              <div class="mb-6">
                <h3 class="text-xs font-bold uppercase tracking-wider text-primary-300 mb-2.5">
                  Key Technical Highlights
                </h3>
                <ul class="space-y-2.5 list-none p-0 m-0">
                  {project.highlights.map((highlight) => (
                    <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-100 font-normal">
                      <span class="text-primary-300 font-bold mt-0.5">✓</span>
                      <span>{highlight}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="flex flex-wrap gap-2 pt-4 border-t border-darkslate-100">
              {project.tech.map((t) => (
                <span class="px-2.5 py-1 rounded-md text-xs font-mono bg-darkslate-400/90 text-primary-200 border border-slate-700 font-semibold">
                  {t}
                </span>
              ))}
            </div>
          </div>

          <div class="lg:col-span-5 bg-darkslate-600/90 border border-slate-700 rounded-lg p-5 flex flex-col justify-between h-full">
            <div>
              <div class="flex items-center justify-between mb-4 pb-3 border-b border-darkslate-100">
                <span class="text-xs font-bold text-white">Architecture Overview</span>
                <span class="text-xs font-mono text-emerald-300 font-bold">Status: Active</span>
              </div>
              <div class="space-y-3.5 text-xs sm:text-sm text-slate-100">
                <div class="flex justify-between">
                  <span class="text-slate-300 font-medium">Organization:</span>
                  <span class="font-bold text-white">Viuumi</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-300 font-medium">Domain:</span>
                  <span class="font-bold text-white">Administration & Analytics</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-300 font-medium">Security Focus:</span>
                  <span class="font-bold text-primary-300">RBAC, Session Defense, Data Privacy</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-300 font-medium">Engineering:</span>
                  <span class="font-bold text-white">Component Architecture & High Performance</span>
                </div>
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-darkslate-100">
              <a
                href={LINKS.github}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-lg bg-primary-600 hover:bg-primary-500 text-white text-xs sm:text-sm font-bold transition-all shadow-md"
              >
                <span>View Code & Repositories</span>
                <Icon name="ri:arrow-right-up-line" class="h-4 w-4" />
              </a>
            </div>
          </div>
        </div>
      </article>
    ))}

    <!-- Additional Specialized Projects Grid -->
    <section class="mt-12">
      <h2 class="text-xl sm:text-2xl font-bold text-white mb-6 flex items-center gap-2">
        <span>Specialized Systems & Tooling</span>
        <span class="text-xs font-bold text-primary-300">({PROJECTS.length - 1} projects)</span>
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {PROJECTS.filter(p => p.id !== "viuumi-admin").map((project) => (
          <article class="rounded-xl bg-darkslate-500 border border-slate-700/80 hover:border-primary-400 p-6 flex flex-col justify-between transition-all group hover:-translate-y-1">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="px-2 py-0.5 rounded text-xs font-mono bg-darkslate-400 text-primary-200 border border-slate-700 font-bold">
                  {project.badge}
                </span>
                <span class="text-xs text-slate-200 font-semibold">{project.status}</span>
              </div>

              <h3 class="text-lg sm:text-xl font-bold text-white mb-2 group-hover:text-primary-300 transition-colors">
                {project.title}
              </h3>

              <p class="text-xs sm:text-sm text-slate-100 font-normal leading-relaxed mb-4">
                {project.description}
              </p>

              <div class="mb-4">
                <span class="text-xs font-bold uppercase tracking-wider text-primary-300 block mb-2">
                  Highlights
                </span>
                <ul class="space-y-1.5 list-none p-0 m-0">
                  {project.highlights.slice(0, 2).map((highlight) => (
                    <li class="flex items-start gap-2 text-xs sm:text-sm text-slate-100 font-normal">
                      <span class="text-primary-300 font-bold mt-0.5">•</span>
                      <span>{highlight}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="pt-4 border-t border-darkslate-100 mt-2">
              <div class="flex flex-wrap gap-1.5 mb-3">
                {project.tech.map((t) => (
                  <span class="px-2 py-0.5 rounded text-xs font-mono bg-darkslate-400/90 text-slate-100 border border-slate-700 font-medium">
                    {t}
                  </span>
                ))}
              </div>
              <a
                href={LINKS.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs sm:text-sm text-primary-300 hover:text-white font-bold group-hover:underline"
              >
                <span>Explore on GitHub</span>
                <Icon name="ri:arrow-right-up-line" class="h-4 w-4" />
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Bottom Footer -->
    <footer class="mt-16 pt-8 border-t border-darkslate-100 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs sm:text-sm text-slate-200 font-medium">
      <p class="m-0">
        © 2026 {PROFILE.name} · {PROFILE.title} · {PROFILE.location}
      </p>
      <a
        href="/"
        class="text-primary-300 hover:text-white font-bold flex items-center gap-1 transition-colors"
      >
        <span>Back to homepage</span>
        <Icon name="ri:arrow-up-line" class="h-4 w-4 rotate-45" />
      </a>
    </footer>
  </div>
</BasicLayout>
