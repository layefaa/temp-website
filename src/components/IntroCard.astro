---
import Card from "./Card/index.astro";
import Button from "./Button.astro";
import { LINKS, PROFILE } from "../lib/constants";
import { Icon } from "astro-icon/components";
import Tooltip from "./Tooltip/index";

interface Props {
  colSpan?: string;
  rowSpan?: string;
}

const { colSpan, rowSpan } = Astro.props;
---

<Card colSpan={colSpan || "lg:col-span-3"} rowSpan={rowSpan || ""}>
  <div class="flex flex-col md:flex-row justify-between w-full h-full gap-4 items-center">
    <div class="flex flex-col justify-between h-full gap-4 flex-1 z-10 w-full">
      <div class="flex flex-col">
        <div class="flex items-center gap-2 mb-3">
          <span class="px-2.5 py-1 text-xs font-bold rounded-full bg-primary-500/25 text-primary-200 border border-primary-400/50">
            {PROFILE.experience} Experience
          </span>
          <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-darkslate-100 text-white border border-darkslate-50">
            📍 {PROFILE.location}
          </span>
        </div>

        <h1 class="m-0 font-bold text-2xl sm:text-3xl lg:text-4xl text-white tracking-tight">
          Hi, I'm <span class="text-white">{PROFILE.name}</span>
          <span class="text-sm sm:text-base font-mono text-primary-300 font-normal ml-1">({PROFILE.handle})</span>
        </h1>
        
        <p class="text-sm sm:text-base font-bold text-primary-300 tracking-wide mt-1.5 mb-0">
          {PROFILE.title}
        </p>

        <p class="mt-3.5 text-sm md:text-base text-slate-200 font-normal leading-relaxed max-w-xl">
          Building high-performance, accessible UI architectures with Next.js &amp; Flutter, backed by deep offensive security research to harden software, systems, and cloud infrastructure.
        </p>

        <div class="mt-4 flex flex-wrap items-center gap-2 text-xs font-mono">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-slate-900/90 border border-slate-700/80 text-emerald-300 font-semibold shadow-sm">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>ENGINE: ONLINE</span>
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-slate-900/90 border border-slate-700/80 text-blue-300 font-semibold shadow-sm">
            <span class="w-2 h-2 rounded-full bg-blue-400"></span>
            <span>NETWORK: SECURE</span>
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-slate-900/90 border border-slate-700/80 text-purple-300 font-semibold shadow-sm">
            <span class="w-2 h-2 rounded-full bg-purple-400"></span>
            <span>VULN OPS: ACTIVE</span>
          </span>
        </div>
      </div>
      <div class="flex items-center gap-3 pt-3">
        <a href={LINKS.github} aria-label="github profile" target="_blank">
          <Button aria-label="github profile">
            <Icon name="ri:github-fill" class="h-6" />
            <span class="sr-only">GitHub Profile</span>
          </Button>
        </a>
        <a href={LINKS.linkedin} aria-label="linkedin profile" target="_blank">
          <Button aria-label="linkedin profile">
            <Icon name="ri:linkedin-box-fill" class="h-6" />
            <span class="sr-only">Linkedin Profile</span>
          </Button>
        </a>
        <a href={`mailto:${LINKS.email}`} aria-label="send email">
          <Button aria-label="send email">
            <Icon name="ri:mail-line" class="h-6" />
            <span class="sr-only">Email</span>
          </Button>
        </a>
        <Tooltip client:visible>
          <Button aria-label="easter egg btn">
            <Icon name="ri:shield-check-line" class="h-6 text-primary-400" />
            <span class="sr-only">Security Status</span>
          </Button>
        </Tooltip>
      </div>
    </div>
    <img
      width="300"
      height="300"
      src="/me.webp"
      class="w-auto max-h-[250px] md:max-h-[270px] select-none absolute right-[-40px] bottom-[-10px] md:relative md:right-auto md:bottom-auto opacity-35 md:opacity-100 pointer-events-none object-contain shrink-0 self-end"
      alt="Profile avatar"
    />
  </div>
</Card>
