---
import { Icon } from 'astro-icon/components'
import Content from "./Content.astro";

interface Props {
  title?: string;
  body?: string;
  colSpan?: string;
  rowSpan?: string;
  href?: string;
  colorText?: string;
}

const { title, body, colSpan, rowSpan, href, colorText } = Astro.props;
---

<div
  class={`card group overflow-hidden bg-darkslate-500 shadow-lg rounded-xl p-5 md:p-6 border border-darkslate-100 hover:border-primary-500 flex flex-col justify-between relative transform perspective-1200 w-full h-full transition duration-150 ease-in-out ${
    colSpan || "col-span-1 md:col-span-2"
  } ${rowSpan || ""}`}
>
  {
    href ? (
      <a href={href} class={`h-full w-full flex flex-col justify-between ${colorText || " "}`}>
        <div>
          <Icon
            name="ri:arrow-right-up-line"
            class="h-5 w-5 float-right text-slate-200 group-hover:text-primary-400 group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform ease-in-out duration-150 z-20"
          />
          <Content title={title} body={body} />
        </div>
        <slot />
      </a>
    ) : (
      <div class="h-full w-full flex flex-col justify-between">
        <Content title={title} body={body}>
          <slot />
        </Content>
      </div>
    )
  }
</div>
