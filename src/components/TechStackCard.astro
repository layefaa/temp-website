---
import Card from "./Card/index.astro";

interface Props {
  colSpan?: string;
  rowSpan?: string;
}

const { colSpan, rowSpan } = Astro.props;

const coreTech = ["TypeScript", "Next.js", "React", "Flutter", "Python", "Go", "TailwindCSS", "SQL"];
const securityStack = ["Wireshark", "Splunk", "Burp Suite", "Suricata", "Vulnerability Audit"];
const cloudAndDevOps = ["GCP", "Docker", "Linux", "Git", "NIST CSF", "ISO 27001"];
---

<Card colSpan={colSpan || "lg:col-span-2"} rowSpan={rowSpan || ""} title="Technical & Security Stack">
  <div class="flex flex-col gap-4 h-full justify-between mt-2">
    <div>
      <span class="text-xs font-bold text-primary-300 uppercase tracking-wider block mb-2">
        Frontend & Core Systems
      </span>
      <div class="flex flex-wrap gap-2">
        {coreTech.map((item) => (
          <span class="px-3 py-1 rounded-md bg-darkslate-400/90 border border-slate-700 text-white font-mono text-xs font-medium hover:border-primary-400 hover:text-primary-200 transition-colors">
            {item}
          </span>
        ))}
      </div>
    </div>

    <div>
      <span class="text-xs font-bold text-primary-300 uppercase tracking-wider block mb-2">
        Cybersecurity Tooling & Ops
      </span>
      <div class="flex flex-wrap gap-2">
        {securityStack.map((item) => (
          <span class="px-3 py-1 rounded-md bg-primary-950/80 border border-primary-400/60 text-primary-100 text-xs font-bold hover:border-primary-300 transition-colors">
            🛡️ {item}
          </span>
        ))}
      </div>
    </div>

    <div class="pt-3 border-t border-darkslate-100">
      <span class="text-xs font-bold text-primary-300 uppercase tracking-wider block mb-2">
        Cloud Infrastructure & Compliance
      </span>
      <div class="flex flex-wrap gap-2">
        {cloudAndDevOps.map((item) => (
          <span class="px-3 py-1 rounded-md bg-darkslate-400/90 border border-slate-700 text-slate-100 text-xs font-medium">
            {item}
          </span>
        ))}
      </div>
    </div>
  </div>
</Card>
