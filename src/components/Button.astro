---
interface Props {
  rounded?: boolean;
}

const { rounded } = Astro.props;
---

<button
  class={`custom-btn text-xl max-h-[50px] shadow-custom shadow-primary-500/70 active:shadow-none active:translate-x-[3px] active:translate-y-[3px] text-white px-5 py-2 border border-primary-500/80 hover:border-primary-400 hover:text-primary-300 transition-colors duration-100 ease-in-out bg-darkslate-400 cursor-pointer ${
    rounded ? "rounded-full" : "rounded-lg"
  }`}
>
  <slot />
</button>
