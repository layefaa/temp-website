---
import { getCurrentTimeInNigeria, formatTimeForNigeria } from "../lib/helpers";
import Card from "./Card/index.astro";

interface Props {
  colSpan?: string;
  rowSpan?: string;
}

const { colSpan, rowSpan } = Astro.props;
---

<script>
  import { onCleanup, onMount } from "solid-js";
  import { formatTimeForNigeria } from "../lib/helpers";

  let interval: ReturnType<typeof setInterval>;

  function updateClock() {
    const timeDisplay = document.getElementById("timeDisplay");
    const now = new Date();

    if (timeDisplay) {
      timeDisplay.textContent = formatTimeForNigeria(now);
      timeDisplay.setAttribute("datetime", now.toISOString());
    }
  }

  onMount(() => {
    interval = setInterval(updateClock, 1000);
  });

  onCleanup(() => {
    clearInterval(interval);
  });
</script>

<Card colSpan={colSpan || "lg:col-span-1"} rowSpan={rowSpan || ""} title="Time Zone">
  <div class="h-full flex flex-col justify-center items-center py-2">
    <time
      datetime=""
      id="timeDisplay"
      class="text-2xl sm:text-3xl xl:text-4xl text-center font-mono flex justify-center items-center text-primary-200 font-bold tracking-tight drop-shadow-sm"
    >
      {formatTimeForNigeria(getCurrentTimeInNigeria())}
    </time>
    <span class="text-xs sm:text-sm text-slate-200 mt-2.5 font-mono font-semibold">Abuja, Nigeria (WAT)</span>
  </div>
</Card>
