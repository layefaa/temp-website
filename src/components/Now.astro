---
import Card from "./Card/index.astro";
import Pulse from "./Pulse.astro";
import { PROFILE } from "../lib/constants";

interface Props {
  colSpan?: string;
  rowSpan?: string;
}

const { colSpan, rowSpan } = Astro.props;
---

<Card colSpan={colSpan || "lg:col-span-1"} rowSpan={rowSpan || ""}>
  <div class="flex flex-col justify-between h-full w-full">
    <div>
      <div class="flex justify-between w-full items-start mb-3">
        <div class="flex flex-col">
          <h2 class="text-xl font-bold text-white m-0">Now</h2>
          <a href="https://sive.rs/nowff" target="_blank" rel="noopener noreferrer">
            <span class="text-xs text-primary-300 hover:text-white cursor-pointer underline font-semibold">what's that?</span>
          </a>
        </div>
        <Pulse />
      </div>

      <div class="space-y-3 mt-3">
        <div>
          <span class="text-xs uppercase tracking-wider text-primary-300 font-bold block mb-1">Current Role</span>
          <p class="text-sm sm:text-base text-white font-bold m-0 leading-snug">{PROFILE.currentRole}</p>
        </div>
        <div>
          <span class="text-xs uppercase tracking-wider text-primary-300 font-bold block mb-1">Key Focus</span>
          <p class="text-sm sm:text-base text-slate-100 font-medium m-0 leading-snug">{PROFILE.currentProject}</p>
        </div>
      </div>
    </div>

    <div class="mt-4 pt-3 border-t border-darkslate-100">
      <span class="text-xs uppercase tracking-wider text-primary-300 font-bold block mb-1">Objective</span>
      <p class="text-xs font-mono text-emerald-300 font-semibold m-0 leading-relaxed">
        &gt; BUILDING SECURE UIs // MASTERING GO &amp; PYTHON
      </p>
    </div>
  </div>
</Card>
