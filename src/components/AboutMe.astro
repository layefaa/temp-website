---
import Card from "./Card/index.astro";
import { PROFILE } from "../lib/constants";

interface Props {
  colSpan?: string;
  rowSpan?: string;
}

const { colSpan, rowSpan } = Astro.props;
---

<Card colSpan={colSpan || "lg:col-span-1"} rowSpan={rowSpan || ""} title="About Me">
  <div class="flex flex-col gap-4 h-full justify-between mt-1">
    <div class="flex flex-col gap-4">
      <div>
        <span class="text-xs uppercase tracking-wider text-primary-300 font-bold block mb-2">
          Mission Profile
        </span>
        <blockquote class="text-xs sm:text-sm font-medium italic border-l-2 border-primary-400 pl-3 py-1.5 bg-primary-950/30 rounded-r text-white m-0 leading-relaxed">
          "{PROFILE.tagline}"
        </blockquote>
      </div>

      <div>
        <span class="text-xs uppercase tracking-wider text-primary-300 font-bold block mb-2">
          Education & Background
        </span>
        <p class="text-xs sm:text-sm text-white font-medium m-0 leading-normal">
          🎓 <b class="font-bold text-white">B.Sc. Computer Science</b><br />
          <span class="text-slate-300 text-xs mt-0.5 block font-normal">University of Benin (2019)</span>
        </p>
      </div>
    </div>

    <div class="pt-3 border-t border-darkslate-100">
      <span class="text-xs text-primary-300 font-semibold block">
        Defense-in-depth · Zero-trust UI
      </span>
    </div>
  </div>
</Card>
